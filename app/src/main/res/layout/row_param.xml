<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/paramIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_timer"
            app:tint="@color/brand" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/paramLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/paramUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/paramMinus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_step_button"
        android:contentDescription="@string/cd_decrease"
        android:padding="9dp"
        android:src="@drawable/ic_minus"
        app:tint="@color/text_primary" />

    <EditText
        android:id="@+id/paramValue"
        android:layout_width="64dp"
        android:layout_height="42dp"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/bg_value_chip"
        android:gravity="center"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="5"
        android:paddingHorizontal="2dp"
        android:paddingVertical="0dp"
        android:selectAllOnFocus="true"
        android:textColor="@color/text_primary"
        android:textColorHighlight="@color/brand"
        android:textSize="17sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/paramPlus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_step_button"
        android:contentDescription="@string/cd_increase"
        android:padding="9dp"
        android:src="@drawable/ic_plus"
        app:tint="@color/text_primary" />
</LinearLayout>
